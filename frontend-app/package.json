  "main": "index.jsx",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "reset:metro": "node -e \"const fs=require('fs');['.expo','node_modules/.cache'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}})\" && expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web"
  },
