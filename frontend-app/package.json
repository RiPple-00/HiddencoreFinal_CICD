    "@react-navigation/native-stack": "^7.14.11",
    "axios": "^1.15.2",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
