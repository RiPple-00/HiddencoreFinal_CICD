# Expo 앱 API 주소
# 이 파일을 .env 로 복사한 뒤 PC IP/포트를 맞추세요.

# Expo Metro 8081 / Spring API 8080
# 폰(Expo Go): IP 자동 (QR exp://IP:8081 과 동일 대역) — 핫스팟·Wi-Fi 모두 가능
EXPO_PUBLIC_API_PORT=8080
EXPO_PUBLIC_CHATBOT_PORT=8001
EXPO_PUBLIC_API_FALLBACK_PORT=8080

# 웹 브라우저에서만 고정 URL이 필요할 때
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# EXPO_PUBLIC_CHATBOT_URL=http://127.0.0.1:8001

# 보호자(guardian001) 시연 환자 — 기만경 260401008
EXPO_PUBLIC_PATIENT_ID=260401008
EXPO_PUBLIC_GALLERY_PATIENT_ID=260401008
EXPO_PUBLIC_MEDICATION_PATIENT_ID=260401008
# EXPO_PUBLIC_REQUESTER_USER_ID=
