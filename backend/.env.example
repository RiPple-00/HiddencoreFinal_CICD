# Spring Boot는 .env 를 자동으로 읽지 않습니다.
# IDE 실행 설정 또는 터미널에서 export/set 한 뒤 사용하세요.
# 더 편한 방법: application-local.yml (application-local.yml.example 참고)

MYSQL_URL=jdbc:mysql://localhost:3306/ddasum?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=root
MYSQL_PASSWORD=12345

JWT_SECRET=ddasum-dev-secret-change-me-please-use-64chars-minimum-00000000000001
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
APP_MAIL_LOG_ONLY=true

MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=

# 복약 QR — 공공데이터포털 serviceKey (application-local.yml 과 동일)
PUBLIC_DATA_SERVICE_KEY=your-public-data-service-key-here

# Python 시드 스크립트(backend/scripts/_*.py)용
MYSQL_HOST=localhost
MYSQL_DATABASE=ddasum
