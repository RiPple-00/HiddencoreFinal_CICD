# 클라우드 프로필 — 비밀값은 환경 변수 / Docker .env / GitHub Secrets 만 사용
# 복사: application-cloud.yml (gitignore) 또는 Docker env_file 로 주입

spring:
  datasource:
    url: ${MYSQL_URL:jdbc:mysql://192.168.0.48:3306/ddasum?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true}
    username: ${MYSQL_USERNAME:ddasum}
    password: ${MYSQL_PASSWORD}

server:
  address: 0.0.0.0
  port: 8080

app:
  jwt:
    secret: ${JWT_SECRET}
  gallery:
    upload-dir: ${APP_GALLERY_UPLOAD_DIR:/data/ddasum/uploads}
    ai-server-base-url: ${AI_SERVER_URL:http://192.168.0.163:8000}
    face-ai-home: ${APP_GALLERY_FACE_AI_HOME:/ai/dasum-face-ai-test}
    ai-server-home: ${APP_GALLERY_AI_SERVER_HOME:/ai/ai-server}
    python-executable: ${PYTHON_EXECUTABLE:python3}
  ai-report:
    enabled: true
    base-url: ${AI_REPORT_URL:http://192.168.0.163:8002}
  translation:
    enabled: false

public-data:
  service-key: ${PUBLIC_DATA_SERVICE_KEY:}
