# 로컬 전용 설정 템플릿
# 1) 이 파일을 application-local.yml 로 복사
# 2) 아래 값을 본인 환경에 맞게 수정
# 3) application-local.yml 은 Git에 올라가지 않음 (.gitignore)

spring:
  datasource:
    username: root
    password: your-mysql-password-here

app:
  jwt:
    # 로컬 개발용 (운영에서는 반드시 64자 이상 랜덤 값 사용)
    secret: ddasum-dev-secret-change-me-please-use-64chars-minimum-00000000000001

server:
  address: 0.0.0.0
  port: 8080

# 복약 QR — 공공데이터포털 키 하나로 연동 (application.properties 와 동일 구조)
public-data:
  service-key: your-public-data-service-key

hira:
  api:
    service-key: ${public-data.service-key}
openapi:
  mfds:
    service-key: ${public-data.service-key}
mfds:
  dur:
    service-key: ${public-data.service-key}
  permit:
    service-key: ${public-data.service-key}
drug:
  api:
    service-key: ${public-data.service-key}

# 보호자 주간 보고서 AI (ai/ai-report FastAPI — OpenAI 키는 ai/chatbot/.env 와 동일)
# app:
#   ai-report:
#     enabled: true
#     base-url: http://127.0.0.1:8002
